# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Salon Decision & Booking Platform"
API_V1_STR=/api/v1

# Security & JWT Auth
SECRET_KEY=replace_with_a_super_secret_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL (via Docker Compose or local installation):
DATABASE_URL=postgresql://salon_user:salon_secure_password_123@localhost:5432/salon_platform_db
# For SQLite (instant zero-configuration local development):
# DATABASE_URL=sqlite:///./salon.db

# AI Hairstyle Transformation Provider
# Supported options: mock, gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
# Maximum upload file size in bytes (5 MB = 5242880 bytes)
MAX_IMAGE_SIZE_BYTES=5242880

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
